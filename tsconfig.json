{
	"compilerOptions": {
		"target": "esnext",
		"module": "esnext",
		"moduleResolution": "bundler",
		"strict": false,
		"noEmit": true,
		"allowImportingTsExtensions": true,
		"skipLibCheck": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"allowUnreachableCode": false,
		"allowUnusedLabels": false
	},
	"include": ["src/**/*.ts", "test/**/*.ts", "index.ts"]
}
